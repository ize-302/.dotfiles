{
	// Mirrors the old swaybar + i3blocks setup using waybar's built-in modules.
	// Glyphs are written as \u escapes so editors can't mangle Nerd Font codepoints.
	"layer": "top",
	"position": "bottom",
	"spacing": 0,
	"modules-left": ["sway/workspaces", "sway/mode"],
	"modules-right": [
		"custom/capslock",
		"temperature",
		"cpu",
		"memory",
		"battery",
		"backlight",
		"wireplumber",
		"custom/kernel",
		"clock#date",
		"clock#time",
		"tray"
	],

	"sway/workspaces": {
		"disable-scroll": false,
		"all-outputs": false
	},

	// keyboard-state needs read access to /dev/input (input group),
	// so caps lock still uses the i3blocks binary.
	// Sway signals RTMIN+8 on Caps_Lock release; the interval is a fallback.
	"custom/capslock": {
		"exec": "$HOME/.config/i3blocks/capslock/capslock",
		"interval": 5,
		"signal": 8,
		"tooltip": false
	},

	// temperature has no `states`, so the colour lives in the icon.
	// Icon index = temp / (critical-threshold / 20) = temp / 5:
	// <50, 50-54, 55-59, 60-64, 65-69, >=70.
	"temperature": {
		"thermal-zone": 0,
		"critical-threshold": 100,
		"interval": 1,
		"format": " {icon} {temperatureC}ºC </span>",
		"format-icons": [
			"<span color='#00FF00'>", "<span color='#00FF00'>",
			"<span color='#00FF00'>", "<span color='#00FF00'>",
			"<span color='#00FF00'>", "<span color='#00FF00'>",
			"<span color='#00FF00'>", "<span color='#00FF00'>",
			"<span color='#00FF00'>", "<span color='#00FF00'>",
			"<span color='#bfff00'>",
			"<span color='#ffff00'>",
			"<span color='#ffbf00'>",
			"<span color='#ff8000'>",
			"<span color='#ff0000'>", "<span color='#ff0000'>",
			"<span color='#ff0000'>", "<span color='#ff0000'>",
			"<span color='#ff0000'>", "<span color='#ff0000'>"
		],
		"tooltip": false
	},

	// Colours come from the state classes in style.css.
	"cpu": {
		"interval": 1,
		"format": "  {usage}% ",
		"states": { "c0": 0, "c10": 10, "c25": 25, "c50": 50, "c60": 60, "c70": 70 },
		"tooltip": false
	},

	"memory": {
		"interval": 1,
		"format": "  {percentage}% ",
		"states": { "c0": 0, "c10": 10, "c25": 25, "c50": 50, "c60": 60, "c70": 70 },
		"tooltip": false
	},

	// Battery states match when capacity <= value.
	"battery": {
		"interval": 1,
		"states": { "lt10": 9, "lt30": 29, "lt50": 49, "lt80": 79, "lt100": 99 },
		"format": " {icon} {capacity}% ",
		"format-discharging": " {icon} {capacity}% {time} ",
		"format-time": "{H}h{M}m",
		"format-icons": {
			"charging": "󰂄",
			"plugged": "󰂄",
			"full": "󰂄",
			"not charging": "󰂄",
			"lt10": "󰁻",
			"lt30": "󰁼",
			"lt50": "󰁾",
			"lt80": "󰂀",
			"default": "󰁹"
		},
		"tooltip": false
	},

	"backlight": {
		"device": "intel_backlight",
		"format": " ☀️{percent}% ",
		"tooltip": false
	},

	// Above 50% switches to the loud icon.
	"wireplumber": {
		"states": { "loud": 51 },
		"format": "  {volume}% ",
		"format-loud": "   {volume}% ",
		"format-muted": "  {volume}% ",
		"tooltip": false
	},

	"custom/kernel": {
		"exec": "uname -r",
		"interval": "once",
		"format": " <span color='#ffcc33'> {}</span> ",
		"tooltip": false
	},

	"clock#date": {
		"format": "  {:%a, %d %b} ",
		"interval": 10,
		"tooltip": false
	},
	"clock#time": {
		"format": " {:%H:%M} ",
		"interval": 10,
		"tooltip": false
	},

	"tray": {
		"icon-size": 21,
		"spacing": 6
	}
}
