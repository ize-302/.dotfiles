#!/bin/bash
# ~/.local/bin/power-menu
# Rofi power menu styled like the app launcher. Pick with arrows + Enter or a
# click. Running it again while open closes it.
if pgrep -x rofi >/dev/null; then
	pkill -x rofi
	exit 0
fi

logout_sound=/usr/share/sounds/freedesktop/stereo/service-logout.oga
locker=(~/.local/bin/lock-screen)

icons=~/.config/rofi/icons

# label (also the icon file name)
entries=(lock logout sleep hibernate reboot shutdown)

menu=""
for entry in "${entries[@]}"; do
	# \0icon\x1f<path> is rofi's per-row icon syntax
	menu+="${menu:+|}$entry\0icon\x1f$icons/$entry.svg"
done

choice="$(printf '%b' "$menu" | rofi -dmenu -sep '|' -show-icons -no-custom \
	-theme ~/.config/rofi/powermenu.rasi)" || exit 0

case "$choice" in
lock) "${locker[@]}" ;;
logout) paplay "$logout_sound" && swaymsg exit ;;
sleep) systemctl suspend ;;
hibernate) paplay "$logout_sound" && "${locker[@]}" && sleep 1 && systemctl hibernate ;;
reboot) paplay "$logout_sound" && systemctl reboot ;;
shutdown) paplay "$logout_sound" && systemctl poweroff -i ;;
esac
