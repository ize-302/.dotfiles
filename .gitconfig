[alias]
	a = add
	co = checkout
	ps = push
	pl = pull
	br = branch
	cm = commit
	cm-a = commit --ammend
	st = status
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
