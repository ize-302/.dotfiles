/**
 * Power menu: same corner panel as the application launcher, driven by
 * ~/.local/bin/power-menu
 **/

@import                          "./launcher.rasi"

/* Just wide enough for the longest label */
window {
    width:                       190px;
}

/* No search box: just the six entries */
mainbox {
    children:                    [ "listview" ];
}

listview {
    lines:                       6;
    fixed-height:                true;
}
