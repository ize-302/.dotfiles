[capslock]
command=./capslock/capslock
interval=1
markup=pango

[temperature]
command=./temperature/temperature
markup=pango
interval=1

[cpu_usage]
command=./cpu_usage/cpu_usage
interval=1
markup=pango

[memory]
command=./memory/memory
markup=pango
interval=1

[battery]
command=./battery/battery
interval=1
markup=pango

[volume]
