color=#ffffff
markup=pango

[temperature]
command=./scripts/temperature/temperature
markup=pango
interval=1

[cpu_usage]
command=./scripts/cpu_usage/cpu_usage
interval=1
markup=pango

[memory]
command=./scripts/memory/memory
