#!/bin/bash
# ~/.local/bin/control-panel [section]
# Toggles the Quickshell control panel (~/.config/quickshell/launcher), or
# with a section ("Notifications", "Network", ...) opens it on that section's
# page, starting its daemon first if it isn't running.
if [ -n "$1" ]; then
	toggle=(qs -c launcher ipc call controlPanel openSection "$1")
else
	toggle=(qs -c launcher ipc call controlPanel toggleControlPanel)
fi

"${toggle[@]}" >/dev/null 2>&1 && exit 0

# Not running yet: start it and wait for it to answer
if qs -c launcher -d >/dev/null 2>&1; then
	for _ in {1..20}; do
		"${toggle[@]}" >/dev/null 2>&1 && exit 0
		sleep 0.1
	done
fi

exit 1
