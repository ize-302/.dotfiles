#!/bin/sh
# ~/.local/bin/clock-status
# The bar's clock (waybar's custom/clock), as JSON: the time over the date
# ("19:34" over "Thu Oct 15"), small enough that the two lines fit the bar's
# height, an orange dot after the time while there are new notifications,
# and a bell with a line through it before it during do not disturb, from what the launcher's
# notification server writes ($XDG_RUNTIME_DIR/notifications.json,
# config/quickshell/launcher/Notifications.qml). Hover shows the date.
status=$(cat "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/notifications.json" 2>/dev/null)

before=""
after=""
class=""
case "$status" in
*'"class":"dnd"'*)
	# Bell with a line through it (nf-md-bell_off), dimmed
	before="<span alpha='55%'>$(printf '\363\260\202\233')</span>  "
	class="dnd"
	;;
*'"class":"unread"'*)
	after=" <span color='#ff7518'>•</span>"
	class="unread"
	;;
esac

# The whole first line, bell and dot too, at the time's size and line
# height: anything larger or raised makes the line taller and pushes the
# date down
time="<span size='10pt' line_height='0.85'>$before<span weight='600'>$(date '+%H:%M')</span>$after</span>"
day="<span size='7.5pt' alpha='80%' line_height='0.85'>$(date '+%a %b %-d')</span>"
printf '{"text": "%s\\n%s", "tooltip": "%s", "class": "%s"}\n' \
	"$time" "$day" "$(date '+%A, %d %B %Y')" "$class"
