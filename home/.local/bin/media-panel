#!/bin/bash
# ~/.local/bin/media-panel
# Toggles the Quickshell music popup (~/.config/quickshell/launcher),
# starting its daemon first if it isn't running.
toggle=(qs -c launcher ipc call media toggleMediaPanel)

"${toggle[@]}" >/dev/null 2>&1 && exit 0

# Not running yet: start it and wait for it to answer
if qs -c launcher -d >/dev/null 2>&1; then
	for _ in {1..20}; do
		"${toggle[@]}" >/dev/null 2>&1 && exit 0
		sleep 0.1
	done
fi

exit 1
