#!/bin/bash
# ~/.local/bin/app-menu
# Toggles the Quickshell app launcher (~/.config/quickshell/launcher), starting
# its daemon first if it isn't running. Falls back to rofi if Quickshell is
# missing or the launcher fails to start.
fallback=(rofi -show drun)
toggle=(qs -c launcher ipc call launcher toggle)

if command -v qs >/dev/null && [ -f ~/.config/quickshell/launcher/shell.qml ]; then
	"${toggle[@]}" >/dev/null 2>&1 && exit 0

	# Not running yet: start it and wait for it to answer
	if qs -c launcher -d >/dev/null 2>&1; then
		for _ in {1..20}; do
			"${toggle[@]}" >/dev/null 2>&1 && exit 0
			sleep 0.1
		done
	fi
fi

exec "${fallback[@]}"
