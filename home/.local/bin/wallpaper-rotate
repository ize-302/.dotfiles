#!/bin/bash
# ~/.local/bin/wallpaper-rotate [seconds]
# Sets a random wallpaper from ~/Pictures/wallpapers on every output, then
# picks a new one every 30 minutes (or the given number of seconds). Runs one
# instance per sway session and stops once that session is gone. Sway drops
# the wallpaper on every reload, so starting it again while it is running puts
# the current image back without restarting the timer.
dir=~/Pictures/wallpapers
interval=${1:-1800}
state="${XDG_RUNTIME_DIR:-/tmp}/wallpaper-rotate.${SWAYSOCK##*/}"

set_bg() {
	swaymsg -q "output * bg \"$1\" fill"
}

exec 9>"$state.lock"
if ! flock -n 9; then
	set_bg "$(<"$state.current")"
	exit
fi

last=
while :; do
	# Never the same image twice in a row
	img=$(find -L "$dir" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) |
		grep -vxF -- "$last" | shuf -n1)
	if [ -n "$img" ]; then
		set_bg "$img" || exit
		echo "$img" >"$state.current"
		last=$img
	fi
	# Without the lock, so a killed rotation can be started again right away
	sleep "$interval" 9>&-
done
